@model PhamSiDuc_deThiMau2023.Models.HangHoa

@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";
}

<div style="padding: 20px 0;">
    <h3>Phạm Sĩ Đức</h3>
    <h4>Thêm Hàng Hóa Mới</h4>
    <hr />

    <form asp-action="Create" method="post" style="max-width: 400px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div style="margin-bottom: 12px;">
            <label>MaLoai</label><br />
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="width: 200px; height: 26px;"></select>
            <span asp-validation-for="MaLoai" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label>TenHang</label><br />
            <input asp-for="TenHang" style="width: 250px; height: 24px;" />
            <span asp-validation-for="TenHang" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label>Gia</label><br />
            <input asp-for="Gia" style="width: 250px; height: 24px;" />
            <span asp-validation-for="Gia" style="color: red; display: block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label>Anh</label><br />
            <input asp-for="Anh" style="width: 250px; height: 24px;" />
            <span asp-validation-for="Anh" style="color: red; display: block;"></span>
        </div>

        <div style="margin-top: 15px;">
            <input type="submit" value="Create" style="padding: 4px 15px; cursor: pointer;" />
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
